# deploy/.env.prod.example — шаблон для /opt/cleancity/.env.prod на VM.
# Скопировать на VM: scp deploy/.env.prod.example user@vm:/opt/cleancity/.env.prod
# Затем заполнить руками и: sudo chmod 600 /opt/cleancity/.env.prod && sudo chown root:root /opt/cleancity/.env.prod

# Имена ENV-переменных должны совпадать с application.conf
# (см. ${?VARIABLE_NAME} подстановки в backend/src/main/resources/application.conf).

APP_STAGE=PROD
APP_BASE_URL=https://api.clean--city.ru

# --- Postgres ---
POSTGRES_DB=cleancity
POSTGRES_USER=cleancity
# Сгенерировать: pwgen -s 32 1
POSTGRES_PASSWORD=REPLACE_ME

# --- JWT (32+ байта base64) ---
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=REPLACE_ME

# --- Yandex Object Storage (фото жалоб) ---
# Bucket cleancity-photos-prod, public-read GET, без листинга.
# Сервисный аккаунт cleancity-photos с ролью storage.editor на этот bucket.
STORAGE_S3_BUCKET=cleancity-photos-prod
STORAGE_S3_ENDPOINT=https://storage.yandexcloud.net
STORAGE_S3_ACCESS_KEY=REPLACE_ME
STORAGE_S3_SECRET_KEY=REPLACE_ME
STORAGE_S3_PUBLIC_URL_BASE=https://cleancity-photos-prod.storage.yandexcloud.net

# --- SMTP (Яндекс 360 для бизнеса) ---
EMAIL_FROM=CleanCity Сочи <noreply@clean--city.ru>
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@clean--city.ru
# App password из настроек Яндекс-почты, НЕ обычный пароль аккаунта.
SMTP_PASSWORD=REPLACE_ME

# --- Seed-админ при первом запуске backend ---
# bootstrapInitialAdmin использует эти значения только если в БД нет ни одного админа.
INITIAL_ADMIN_EMAIL=REPLACE_ME@example.com
INITIAL_ADMIN_PASSWORD=REPLACE_ME_TEMP_CHANGE_ON_FIRST_LOGIN
