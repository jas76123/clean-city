# ============================================================================
# CleanCity — шаблон переменных окружения
# ============================================================================
# Скопируй в `.env` и заполни реальными значениями. `.env` НЕ коммитится.
# Для production-секретов используй Yandex Lockbox или secrets-менеджер CI.
#
#   cp .env.example .env
#
# ============================================================================

# ----- База данных (Postgres) ---------------------------------------------
# Для локальной разработки docker-compose поднимает Postgres с этими значениями.
# В production — управляемый Postgres на Yandex Cloud, пароль от secrets-менеджера.
DB_URL=jdbc:postgresql://localhost:5433/cleancity
DB_USER=cleancity
DB_PASSWORD=__GENERATE_STRONG_PASSWORD__
POSTGRES_DB=cleancity
POSTGRES_USER=cleancity
POSTGRES_PASSWORD=__GENERATE_STRONG_PASSWORD__

# ----- Backend ------------------------------------------------------------
# Порт HTTP-сервера. Локально 8080, в prod — за reverse-proxy (Caddy).
KTOR_PORT=8080
# Путь для локального хранилища фото (когда S3 не настроен).
STORAGE_PATH=./uploads

# ----- JWT ----------------------------------------------------------------
# Минимум 32 байта случайных. Сгенерируй через:
#   openssl rand -base64 48
JWT_SECRET=__REPLACE_WITH_BASE64_SECRET__
JWT_ISSUER=cleancity
JWT_AUDIENCE=cleancity-api

# ----- Object Storage (Yandex Object Storage, S3-совместимый) ------------
# Создай service-аккаунт + статические ключи в кабинете Yandex Cloud.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=cleancity-photos-prod
S3_ACCESS_KEY_ID=__YC_ACCESS_KEY_ID__
S3_SECRET_ACCESS_KEY=__YC_SECRET_ACCESS_KEY__

# ----- Yandex Maps SDK ----------------------------------------------------
# Получить в developer.tech.yandex.ru. Привязать к package name приложения.
# Для Android-клиента дополнительно лежит в local.properties.
YANDEX_MAPS_API_KEY=__YANDEX_MAPS_KEY__

# ----- Email (SMTP) -------------------------------------------------------
# Yandex Mail SMTP — рекомендуемый российский SMTP.
# Для production создай отдельный почтовый ящик и пароль приложения.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@cleancity.ru
SMTP_PASSWORD=__SMTP_APP_PASSWORD__
EMAIL_FROM=noreply@cleancity.ru

# ----- Firebase Cloud Messaging (push-уведомления) ------------------------
# Скачай service-account JSON из Firebase Console → положи в ./secrets/fcm.json
FCM_CREDENTIALS_PATH=./secrets/fcm.json

# ----- Первый администратор (применяется миграцией V7) -------------------
INITIAL_ADMIN_EMAIL=admin@cleancity.ru
INITIAL_ADMIN_PASSWORD=__INITIAL_ADMIN_PASSWORD__

# ----- Окружение ---------------------------------------------------------
# DEV / STAGING / PROD — влияет на строгость security-проверок и логирование.
APP_STAGE=DEV
