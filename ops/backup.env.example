# Конфигурация для /opt/cleancity/backup.sh
# Деплой как /etc/cleancity/backup.env, mode 0600, owner root.

# Postgres connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=cleancity
PGUSER=cleancity
PGPASSWORD=CHANGEME

# GPG passphrase: один файл, mode 0600, ТОЛЬКО root.
# Пример создания:
#   openssl rand -base64 64 | sudo tee /etc/cleancity/backup-gpg.pass > /dev/null
#   sudo chmod 600 /etc/cleancity/backup-gpg.pass
GPG_PASSPHRASE_FILE=/etc/cleancity/backup-gpg.pass

# Yandex Object Storage (S3-совместимое API)
S3_BUCKET=cleancity-backups
S3_ENDPOINT=https://storage.yandexcloud.net
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
AWS_DEFAULT_REGION=ru-central1

# Telegram-алерт (см. ops/alert.sh) — необязательно, отсутствие безопасно.
ALERT_SCRIPT=/opt/cleancity/alert.sh
