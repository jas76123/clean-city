# Конфигурация для /opt/cleancity/alert.sh
# Деплой как /etc/cleancity/alert.env, mode 0600, owner root.

# Токен от @BotFather. Хранится только на сервере, в .env приложения
# дублировать не обязательно — TelegramAppender читает свои переменные.
TELEGRAM_BOT_TOKEN=__TG_BOT_TOKEN__

# ID чата/группы. Для группы — отрицательное число (-100xxx...).
# Узнать можно через @userinfobot или GetUpdates.
TELEGRAM_CHAT_ID=__TG_CHAT_ID__
